# Copy this file to ".env" (same folder) and change the values.
# The ".env" file is git-ignored, so your secrets never go to GitHub.

# Long random string used to sign login tokens. Change it!
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
ERGOSENSE_SECRET_KEY=change-me-to-a-long-random-string

# 1 = run with fake (mock) sensors, no webcam / ESP32 needed. 0 = real hardware.
ERGOSENSE_MOCK=1

# Login token lifetime in minutes (720 = 12 hours)
ERGOSENSE_ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database file (SQLite). Created automatically.
ERGOSENSE_DATABASE_URL=sqlite:///./ergosense.db

# Frontend addresses allowed to call the API (comma separated)
ERGOSENSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
